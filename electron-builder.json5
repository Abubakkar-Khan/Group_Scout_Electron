{
  appId: "com.groupscout.app",
  productName: "GroupScout",
  directories: {
    output: "release"
  },
  asar: true,
  asarUnpack: [
    ".next/standalone/**/*",
    ".next/static/**/*",
    "public/**/*",
    "prisma/**/*",
    "node_modules/next/**/*",
    "node_modules/@next/**/*",
    "node_modules/.prisma/**/*",
    "node_modules/@prisma/**/*",
    "node_modules/playwright/**/*"
  ],
  files: [
    "dist-electron/**/*",
    ".next/standalone/**/*",
    ".next/static/**/*",
    "public/**/*",
    "package.json",
    ".env",
    "prisma/**/*",
    "node_modules/next/**/*",
    "node_modules/@next/**/*",
    "node_modules/.prisma/**/*",
    "node_modules/@prisma/**/*"
  ],
  win: {
    target: ["nsis"],
    icon: "public/icon.ico"
  },
  nsis: {
    oneClick: false,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: "GroupScout"
  }
}
