{
  appId: "com.groupscout.app",
  productName: "GroupScout",
  directories: {
    output: "release"
  },
  asar: true,
  compression: "normal",
  files: [
    "dist-electron/**/*",
    "package.json",
    "!node_modules/**/*"
  ],
  extraResources: [
    {
      from: ".next/standalone",
      to: "next",
      filter: ["**/*", "!node_modules/**/*"]
    },
    {
      from: ".next/standalone/node_modules",
      to: "next/node_modules",
      filter: ["**/*"]
    },
    {
      from: ".next/static",
      to: "next/.next/static",
      filter: ["**/*"]
    },
    {
      from: "public",
      to: "next/public",
      filter: ["**/*"]
    },
    {
      from: "prisma",
      to: "prisma",
      filter: ["dev.db", "schema.prisma"]
    }
  ],
  win: {
    target: ["zip", "nsis"],
    icon: "public/icon.ico"
  },
  mac: {
    target: ["dmg", "zip"],
    category: "public.app-category.utilities",
    icon: "public/icon.png"
  },
  nsis: {
    oneClick: false,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
    shortcutName: "GroupScout",
    differentialPackage: false
  }
}
